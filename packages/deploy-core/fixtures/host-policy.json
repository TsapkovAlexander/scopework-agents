{
  "commandKinds": [
    "apply",
    "backup",
    "restore",
    "export",
    "migrate-data",
    "start-stack",
    "stop-stack",
    "inventory"
  ],
  "maxBytes": 4096,
  "cases": [
    {
      "name": "файла нет — прежнее поведение",
      "text": null,
      "expect": {
        "state": "absent"
      }
    },
    {
      "name": "пример из ADR-0095 п. 1 дословно",
      "text": "# /etc/tracedocs/agent-policy.conf — root:root 0644\nversion=1\nmode=observe                  # observe | deploy\ncommands=inventory            # через запятую, только из закрытого списка (п. 4)\ndeploy_agent_updates=manual   # manual | auto | pinned 2.2.0\nmonitor_agent_updates=manual  # manual | auto | pinned 1.1.0\ncontainer_logs=deny           # allow | deny\n",
      "expect": {
        "state": "valid",
        "mode": "observe",
        "commands": [
          "inventory"
        ],
        "deployAgentUpdates": "manual",
        "monitorAgentUpdates": "manual",
        "containerLogs": "deny"
      }
    },
    {
      "name": "только version=1, без перевода строки в конце: всё строгое",
      "text": "version=1",
      "expect": {
        "state": "valid",
        "mode": "observe",
        "commands": [],
        "deployAgentUpdates": "manual",
        "monitorAgentUpdates": "manual",
        "containerLogs": "deny"
      }
    },
    {
      "name": "mode=deploy без commands — все виды",
      "text": "version=1\nmode=deploy\n",
      "expect": {
        "state": "valid",
        "mode": "deploy",
        "commands": [
          "apply",
          "backup",
          "restore",
          "export",
          "migrate-data",
          "start-stack",
          "stop-stack",
          "inventory"
        ],
        "deployAgentUpdates": "manual",
        "monitorAgentUpdates": "manual",
        "containerLogs": "deny"
      }
    },
    {
      "name": "mode=observe без commands — пустой список",
      "text": "version=1\nmode=observe\n",
      "expect": {
        "state": "valid",
        "mode": "observe",
        "commands": [],
        "deployAgentUpdates": "manual",
        "monitorAgentUpdates": "manual",
        "containerLogs": "deny"
      }
    },
    {
      "name": "commands= при deploy — явный пустой список",
      "text": "version=1\nmode=deploy\ncommands=\n",
      "expect": {
        "state": "valid",
        "mode": "deploy",
        "commands": [],
        "deployAgentUpdates": "manual",
        "monitorAgentUpdates": "manual",
        "containerLogs": "deny"
      }
    },
    {
      "name": "commands с пустыми элементами, пробелами и повтором",
      "text": "version=1\nmode=deploy\ncommands=backup,,restore, backup\n",
      "expect": {
        "state": "valid",
        "mode": "deploy",
        "commands": [
          "backup",
          "restore"
        ],
        "deployAgentUpdates": "manual",
        "monitorAgentUpdates": "manual",
        "containerLogs": "deny"
      }
    },
    {
      "name": "commands в чужом порядке — действующий список в порядке закрытого",
      "text": "version=1\nmode=deploy\ncommands=inventory,stop-stack,apply\n",
